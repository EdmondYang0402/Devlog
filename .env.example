MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=devlog
MYSQL_USER=devlog_user
MYSQL_PASSWORD=

REDIS_PASSWORD=

# 至少 32 字节；生产环境请使用随机长字符串。
JWT_SECRET=

FRONTEND_PORT=8088
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx768m

# 多个来源用逗号分隔；生产域名上线后请追加实际 HTTPS 域名。
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://localhost:8088,https://*.trycloudflare.com

# 上传文件保存在 Docker volume；通常不需要修改。
APP_UPLOAD_DIR=/app/uploads
APP_UPLOAD_PUBLIC_URL_PREFIX=/uploads
